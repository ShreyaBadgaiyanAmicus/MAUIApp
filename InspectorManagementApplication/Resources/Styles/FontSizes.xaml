<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Heading Sizes -->
    <x:Double x:Key="PageTitleFontSize">28</x:Double>
    <x:Double x:Key="SectionTitleFontSize">20</x:Double>
    <x:Double x:Key="CardTitleFontSize">16</x:Double>

    <!-- Body and Supporting Text -->
    <x:Double x:Key="BodyFontSize">16</x:Double>
    <x:Double x:Key="CaptionFontSize">13</x:Double>
    <x:Double x:Key="SmallFontSize">11</x:Double>

    <!-- Interactive Elements -->
    <x:Double x:Key="ButtonFontSize">15</x:Double>

    <!-- Dashboard Values -->
    <x:Double x:Key="DashboardValueFontSize">26</x:Double>

    <!-- Font Families -->
    <x:String x:Key="RegularFont">PoppinsRegular</x:String>
    <x:String x:Key="SemiBoldFont">PoppinsSemiBold</x:String>

</ResourceDictionary>
