<ResourceDictionary>

    <!-- Primary Theme -->
    <Color x:Key="Primary">#365F8D</Color>
    <Color x:Key="PrimaryDark">#294B72</Color>
    <Color x:Key="PrimaryDarkText">#1E293B</Color>
    <Color x:Key="Secondary">#E8EDF3</Color>
    <Color x:Key="SecondaryDarkText">#475569</Color>
    <Color x:Key="Tertiary">#64748B</Color>

    <!-- Basic Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1E293B</Color>

    <!-- Neutral Colors -->
    <Color x:Key="Gray100">#F4F6F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#1E293B</Color>
    <Color x:Key="Gray950">#0F172A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Priority Badge Colors -->
    <Color x:Key="PriorityHigh">#B84D45</Color>
    <Color x:Key="PriorityHighBackground">#FCE9E7</Color>

    <Color x:Key="PriorityMedium">#946B19</Color>
    <Color x:Key="PriorityMediumBackground">#FFF3D9</Color>

    <Color x:Key="PriorityLow">#356B91</Color>
    <Color x:Key="PriorityLowBackground">#E8F1F8</Color>

    <!-- Status Badge Colors -->
    <Color x:Key="StatusPending">#946B19</Color>
    <Color x:Key="StatusPendingBackground">#FFF3D9</Color>

    <Color x:Key="StatusInProgress">#356B91</Color>
    <Color x:Key="StatusInProgressBackground">#E8F1F8</Color>

    <Color x:Key="StatusCompleted">#47765B</Color>
    <Color x:Key="StatusCompletedBackground">#E8F3EC</Color>

    <!-- Selection -->
    <Color x:Key="SelectedItemBackground">#EAF2FF</Color>

</ResourceDictionary>
