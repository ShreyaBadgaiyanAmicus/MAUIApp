<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Padding -->
    <Thickness x:Key="PagePadding">20</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SmallPadding">8</Thickness>
    <Thickness x:Key="CompactPadding">12</Thickness>

    <!-- Spacing -->
    <x:Double x:Key="ExtraSmallSpacing">2</x:Double>
    <x:Double x:Key="SmallSpacing">8</x:Double>
    <x:Double x:Key="MediumSpacing">12</x:Double>
    <x:Double x:Key="LargeSpacing">20</x:Double>
    <x:Double x:Key="ExtraLargeSpacing">24</x:Double>
    <x:Double x:Key="SectionSpacing">16</x:Double>

    <!-- Corner Radii -->
    <x:Double x:Key="SmallCornerRadius">8</x:Double>
    <x:Double x:Key="MediumCornerRadius">12</x:Double>
    <x:Double x:Key="LargeCornerRadius">16</x:Double>
    <x:Double x:Key="ButtonCornerRadius">10</x:Double>

</ResourceDictionary>
