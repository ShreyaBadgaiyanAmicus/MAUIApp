<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InspectorManagementApplication.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:InspectorManagementApplication.Views"
    Title="Inspector Management">

    <TabBar>

        <!-- Dashboard Tab -->
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate pages:DashboardPage}"
            Route="DashboardPage" />

        <!-- Inspections Tab -->
        <ShellContent
            Title="Inspections"
            ContentTemplate="{DataTemplate pages:InspectionListPage}"
            Route="InspectionListPage" />

        <!-- Profile Tab -->
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate pages:InspectorProfilePage}"
            Route="ProfilePage" />

    </TabBar>

</Shell>
