<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InspectorManagementApplication.Views.DashboardPage"
    Title="Dashboard"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource Gray100}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Profile"
            Order="Primary"
            Priority="0"
            Clicked="OnProfileClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource SmallPadding}"
            Spacing="{StaticResource LargeSpacing}">

            <!-- Dashboard Header -->
            <VerticalStackLayout Spacing="{StaticResource ExtraSmallSpacing}">
                <Label
                    Text="Welcome back! Here's an overview of your inspections."
                    FontSize="{StaticResource CaptionFontSize}"
                    TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <!-- Summary -->
            <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                <Label
                    Text="Overview"
                    Style="{StaticResource SectionHeadingStyle}" />

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource MediumSpacing}"
                    RowSpacing="{StaticResource MediumSpacing}">

                    <!-- Total -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label
                                Text="Total Inspections"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Text="24"
                                FontSize="{StaticResource DashboardValueFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pending -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label
                                Text="Pending"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Text="8"
                                FontSize="{StaticResource DashboardValueFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusPending}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- In Progress -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label
                                Text="In Progress"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Text="10"
                                FontSize="{StaticResource DashboardValueFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusInProgress}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Completed -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                            <Label
                                Text="Completed"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Text="6"
                                FontSize="{StaticResource DashboardValueFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusCompleted}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>

            <!-- Today's Inspections -->
            <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource SmallSpacing}">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="{StaticResource ExtraSmallSpacing}"
                        VerticalOptions="Center">

                        <Label
                            Text="Today's Inspections"
                            Style="{StaticResource SectionHeadingStyle}" />

                        <Label
                            Text="Your scheduled inspection activities"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Show all"
                        FontSize="{StaticResource CaptionFontSize}"
                        TextColor="{StaticResource Primary}"
                        BackgroundColor="Transparent"
                        Padding="{StaticResource SmallPadding}"
                        Clicked="OnShowAllClicked"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Inspection 1 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Safety Equipment Inspection"
                                Grid.Column="0"
                                FontSize="{StaticResource BodyFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Gray900}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="High"
                                FontSize="{StaticResource SmallFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PriorityHigh}"
                                BackgroundColor="{StaticResource PriorityHighBackground}"
                                Padding="{StaticResource SmallPadding}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="Pune Industrial Site"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="10:00 AM"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Grid.Column="1"
                                Text="Pending"
                                FontSize="{StaticResource CaptionFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusPending}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 2 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Building Maintenance Check"
                                Grid.Column="0"
                                FontSize="{StaticResource BodyFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Gray900}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="Medium"
                                FontSize="{StaticResource SmallFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PriorityMedium}"
                                BackgroundColor="{StaticResource PriorityMediumBackground}"
                                Padding="{StaticResource SmallPadding}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="Mumbai Office"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="02:00 PM"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Grid.Column="1"
                                Text="In Progress"
                                FontSize="{StaticResource CaptionFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusInProgress}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 3 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Fire Safety Inspection"
                                Grid.Column="0"
                                FontSize="{StaticResource BodyFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Gray900}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="High"
                                FontSize="{StaticResource SmallFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PriorityHigh}"
                                BackgroundColor="{StaticResource PriorityHighBackground}"
                                Padding="{StaticResource SmallPadding}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="Chennai Warehouse"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="03:30 PM"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Grid.Column="1"
                                Text="Completed"
                                FontSize="{StaticResource CaptionFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusCompleted}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 4 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Electrical Systems Check"
                                Grid.Column="0"
                                FontSize="{StaticResource BodyFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Gray900}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="Low"
                                FontSize="{StaticResource SmallFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PriorityLow}"
                                BackgroundColor="{StaticResource PriorityLowBackground}"
                                Padding="{StaticResource SmallPadding}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="Bengaluru Office"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="04:30 PM"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Grid.Column="1"
                                Text="Pending"
                                FontSize="{StaticResource CaptionFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusPending}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 5 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Quality Compliance Audit"
                                Grid.Column="0"
                                FontSize="{StaticResource BodyFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Gray900}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="Medium"
                                FontSize="{StaticResource SmallFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PriorityMedium}"
                                BackgroundColor="{StaticResource PriorityMediumBackground}"
                                Padding="{StaticResource SmallPadding}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="Hyderabad Facility"
                            FontSize="{StaticResource CaptionFontSize}"
                            TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="05:30 PM"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray500}" />
                            <Label
                                Grid.Column="1"
                                Text="In Progress"
                                FontSize="{StaticResource CaptionFontSize}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource StatusInProgress}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
