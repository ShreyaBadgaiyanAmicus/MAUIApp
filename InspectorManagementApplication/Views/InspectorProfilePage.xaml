<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InspectorManagementApplication.Views.InspectorProfilePage"
    Title="My Profile"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource PagePadding}"
            Spacing="{StaticResource LargeSpacing}">

            <!-- Profile Header Card -->
            <Border
                Style="{StaticResource CardBorderStyle}"
                Padding="{StaticResource ExtraLargeSpacing}">

                <VerticalStackLayout
                    Spacing="{StaticResource SmallSpacing}"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="112"
                        HeightRequest="112"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 56"
                        Padding="{StaticResource ExtraSmallSpacing}">

                        <Image
                            Source="inspector_profile.png"
                            HeightRequest="104"
                            WidthRequest="104"
                            Aspect="AspectFill" />
                    </Border>

                    <Label
                        Text="Alex Morgan"
                        FontSize="{StaticResource PageTitleFontSize}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray900}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Senior Inspector"
                        FontSize="{StaticResource CaptionFontSize}"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center" />

                    <Border
                        BackgroundColor="{StaticResource PriorityLowBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="{StaticResource SmallPadding}"
                        HorizontalOptions="Center">

                        <Label
                            Text="Employee ID: INS-1024"
                            FontSize="{StaticResource SmallFontSize}"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PriorityLow}" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Contact Information -->
            <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">

                <Label
                    Text="Contact Information"
                    Style="{StaticResource SectionHeadingStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">

                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">

                        <VerticalStackLayout Spacing="{StaticResource ExtraSmallSpacing}">
                            <Label
                                Text="EMAIL ADDRESS"
                                Style="{StaticResource FormLabelStyle}" />

                            <Label
                                Text="alex.morgan@example.com"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray900}" />
                        </VerticalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Gray200}" />

                        <VerticalStackLayout Spacing="{StaticResource ExtraSmallSpacing}">
                            <Label
                                Text="PHONE NUMBER"
                                Style="{StaticResource FormLabelStyle}" />

                            <Label
                                Text="+91 98765 43210"
                                FontSize="{StaticResource CaptionFontSize}"
                                TextColor="{StaticResource Gray900}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Profile Settings -->
            <VerticalStackLayout Spacing="{StaticResource SmallSpacing}">

                <Label
                    Text="Profile Settings"
                    Style="{StaticResource SectionHeadingStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">

                    <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">

                        <!-- Full Name -->
                        <Label
                            Text="Full Name"
                            Style="{StaticResource FormLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="Alex Morgan"
                                Placeholder="Enter your name" />
                        </Border>

                        <!-- Phone Number -->
                        <Label
                            Text="Phone Number"
                            Style="{StaticResource FormLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry
                                Text="+91 98765 43210"
                                Placeholder="Enter phone number"
                                Keyboard="Telephone" />
                        </Border>

                        <!-- Designation -->
                        <Label
                            Text="Designation"
                            Style="{StaticResource FormLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Picker
                                Title="Select designation"
                                SelectedIndex="0">

                                <Picker.Items>
                                    <x:String>Senior Inspector</x:String>
                                    <x:String>Junior Inspector</x:String>
                                    <x:String>Inspection Manager</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Gray200}" />

                        <!-- Notifications -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{StaticResource SmallSpacing}">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="{StaticResource ExtraSmallSpacing}"
                                VerticalOptions="Center">

                                <Label
                                    Text="Inspection Notifications"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Gray600}" />

                                <Label
                                    Text="Receive inspection updates"
                                    FontSize="{StaticResource SmallFontSize}"
                                    TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>

                            <Switch
                                Grid.Column="1"
                                IsToggled="True"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Gray200}" />

                        <!-- Date of Joining -->
                        <Label
                            Text="Date of Joining"
                            Style="{StaticResource FormLabelStyle}" />

                        <Border Style="{StaticResource InputBorderStyle}">
                            <DatePicker
                                Date="2020-06-15"
                                Format="dd MMM yyyy" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Edit Button -->
            <Button
                Text="Save Profile"
                Style="{StaticResource PrimaryButtonStyle}"
                FontSize="{StaticResource CaptionFontSize}"
                HeightRequest="48"
                Margin="0,0,0,8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
