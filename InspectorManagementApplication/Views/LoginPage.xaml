<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InspectorManagementApplication.Views.LoginPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <Grid
            Padding="{StaticResource PagePadding}"
            VerticalOptions="Center">

            <Border
                Style="{StaticResource CardBorderStyle}"
                Padding="{StaticResource ExtraLargeSpacing}">

                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">

                    <!-- App Identity -->
                    <Label
                        Text="INSPECTOR MANAGEMENT"
                        FontSize="{StaticResource CaptionFontSize}"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center"
                        Margin="0,4,0,18" />

                    <!-- Heading -->
                    <Label
                        Text="Welcome Back"
                        FontSize="{StaticResource PageTitleFontSize}"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray900}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Sign in to continue to your account"
                        FontSize="{StaticResource CaptionFontSize}"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center"
                        Margin="0,0,0,22" />

                    <!-- Email -->
                    <Label
                        Text="Email Address"
                        Style="{StaticResource FormLabelStyle}" />

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry
                            Placeholder="Enter your email"
                            Keyboard="Email"
                            Text="{Binding Email, Mode=TwoWay}" />
                    </Border>

                    <Label
                        Text="{Binding EmailError}"
                        TextColor="#DC5555"
                        FontSize="{StaticResource SmallFontSize}"
                        MinimumHeightRequest="15" />

                    <!-- Password -->
                    <Label
                        Text="Password"
                        Style="{StaticResource FormLabelStyle}" />

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry
                            Placeholder="Enter your password"
                            IsPassword="True"
                            Text="{Binding Password, Mode=TwoWay}" />
                    </Border>

                    <Label
                        Text="{Binding PasswordError}"
                        TextColor="#DC5555"
                        FontSize="{StaticResource SmallFontSize}"
                        MinimumHeightRequest="15" />

                    <!-- Login Button -->
                    <Button
                        Text="Sign In"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="58"
                        Margin="0,12,0,0">

                        <Button.Triggers>
                            <Trigger
                                TargetType="Button"
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Gray300}" />

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource Gray500}" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Login Result -->
                    <Label
                        Text="{Binding LoginMessage}"
                        TextColor="{Binding LoginMessageColor}"
                        HorizontalOptions="Center"
                        FontSize="{StaticResource SmallFontSize}"
                        FontAttributes="Bold"
                        Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
