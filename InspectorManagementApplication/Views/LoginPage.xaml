<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InspectorManagementApplication.Views.LoginPage"
    Title="Login"
    BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="12"
            VerticalOptions="Center">

            <Label
                Text="Welcome Back"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Sign in to continue"
                FontSize="14"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <!-- Email -->
            <Label
                Text="Email"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter your email"
                Keyboard="Email"
                Text="{Binding Email, Mode=TwoWay}" />

            <Label
                Text="{Binding EmailError}"
                TextColor="Red"
                FontSize="12"
                MinimumHeightRequest="16" />

            <!-- Password -->
            <Label
                Text="Password"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter your password"
                IsPassword="True"
                Text="{Binding Password, Mode=TwoWay}" />

            <Label
                Text="{Binding PasswordError}"
                TextColor="Red"
                FontSize="12"
                MinimumHeightRequest="16" />

            <!-- Login -->

            <Button
    Text="Login"
    IsEnabled="{Binding IsLoginEnabled}"
    Clicked="OnLoginClicked"
    BackgroundColor="#2563EB"
    TextColor="White"
    Margin="0,15,0,0">

                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="BackgroundColor" Value="#D1D5DB" />
                        <Setter Property="TextColor" Value="#6B7280" />
                    </Trigger>
                </Button.Triggers>

            </Button>


            <!-- Login Result -->
            <Label
                Text="{Binding LoginMessage}"
                TextColor="{Binding LoginMessageColor}"
                HorizontalOptions="Center"
                FontSize="13"
                FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
