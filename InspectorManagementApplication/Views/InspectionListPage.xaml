<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="InspectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InspectorManagementApplication.Views.Controls"
    x:Class="InspectorManagementApplication.Views.InspectionListPage"
    Title="All Inspections"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Page Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="{StaticResource PagePadding}"
            Spacing="{StaticResource ExtraSmallSpacing}">

            <Label
                Text="Manage and track your scheduled inspections."
                FontSize="{StaticResource CaptionFontSize}"
                TextColor="{StaticResource Gray500}" />

            <HorizontalStackLayout
                Spacing="{StaticResource SmallSpacing}"
                Margin="0,8,0,0">

                <!-- Reload Button -->
                <Button
                    Text="Reload Inspections"
                    Command="{Binding LoadInspectionsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="{StaticResource SmallFontSize}"
                    Padding="{StaticResource CompactPadding}">

                    <Button.Triggers>
                        <Trigger
                            TargetType="Button"
                            Property="IsEnabled"
                            Value="False">
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            <Setter Property="Text" Value="Loading..." />
                        </Trigger>
                    </Button.Triggers>
                </Button>

                <!-- New Inspection Button -->
                <Button
                    Text="+ New Inspection"
                    Clicked="OnNewInspectionClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="{StaticResource SmallFontSize}"
                    Padding="{StaticResource CompactPadding}" />

            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Search -->
        <Border
            Grid.Row="1"
            Margin="{StaticResource PagePadding}"
            Style="{StaticResource InputBorderStyle}"
            Padding="{StaticResource SmallPadding}">

            <Entry
                Placeholder="Search inspections..."
                Text="{Binding SearchText, Mode=TwoWay}"
                ClearButtonVisibility="WhileEditing" />
        </Border>

        <!-- View Switcher -->
        <Border
            Grid.Row="2"
            Margin="{StaticResource PagePadding}"
            Padding="{StaticResource ExtraSmallSpacing}"
            BackgroundColor="{StaticResource Secondary}"
            StrokeThickness="0">

            <Grid ColumnDefinitions="*,*">

                <Button
                    Grid.Column="0"
                    Text="Collection View"
                    Command="{Binding ShowCollectionViewCommand}"
                    FontSize="{StaticResource SmallFontSize}"
                    FontAttributes="Bold"
                    CornerRadius="{StaticResource SmallCornerRadius}"
                    Padding="{StaticResource SmallPadding}">

                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsCollectionViewVisible}"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsCollectionViewVisible}"
                            Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button
                    Grid.Column="1"
                    Text="List View"
                    Command="{Binding ShowListViewCommand}"
                    FontSize="{StaticResource SmallFontSize}"
                    FontAttributes="Bold"
                    CornerRadius="{StaticResource SmallCornerRadius}"
                    Padding="{StaticResource SmallPadding}">

                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsListViewVisible}"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsListViewVisible}"
                            Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Border>

        <!-- CollectionView with Pull-to-Refresh -->
        <RefreshView
            Grid.Row="3"
            Margin="{StaticResource SmallPadding}"
            IsVisible="{Binding IsCollectionViewVisible}"
            Command="{Binding LoadInspectionsCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">

            <CollectionView
                x:Name="InspectionsCollectionView"
                ItemsSource="{Binding Inspections}"
                SelectedItem="{Binding SelectedInspection, Mode=TwoWay}"
                SelectionMode="Single"
                SelectionChanged="OnInspectionSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,10">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource White}" />
                                            <Setter Property="Stroke" Value="{StaticResource Gray200}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource SelectedItemBackground}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="{StaticResource MediumSpacing}">

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="{StaticResource SmallSpacing}">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource BodyFontSize}"
                                        TextColor="{StaticResource Gray900}"
                                        VerticalOptions="Center" />

                                    <controls:StatusBadge
                                        Grid.Column="1"
                                        Status="{Binding Status}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding SiteName}"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    TextColor="{StaticResource Gray500}" />

                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="{StaticResource SmallSpacing}">

                                    <!-- Priority -->
                                    <Border
                                        Grid.Column="0"
                                        Padding="{StaticResource SmallPadding}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="High">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighBackground}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Medium">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumBackground}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Low">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowBackground}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label
                                            Text="{Binding Priority}"
                                            FontSize="{StaticResource SmallFontSize}"
                                            FontAttributes="Bold">

                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="TextColor" Value="{StaticResource PriorityHigh}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Medium">
                                                    <Setter Property="TextColor" Value="{StaticResource PriorityMedium}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Low">
                                                    <Setter Property="TextColor" Value="{StaticResource PriorityLow}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ScheduledOn, Converter={StaticResource DateToRelativeTextConverter}, StringFormat='Scheduled: {0}'}"
                                        FontSize="{StaticResource CaptionFontSize}"
                                        TextColor="{StaticResource Gray500}"
                                        HorizontalTextAlignment="End"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- ListView with Pull-to-Refresh -->
        <RefreshView
            Grid.Row="3"
            Margin="{StaticResource SmallPadding}"
            IsVisible="{Binding IsListViewVisible}"
            Command="{Binding LoadInspectionsCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">

            <ListView
                x:Name="InspectionsListView"
                ItemsSource="{Binding Inspections}"
                SelectionMode="None"
                SeparatorVisibility="None"
                HasUnevenRows="True"
                BackgroundColor="Transparent">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,0,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInspectionTapped" />
                                </Border.GestureRecognizers>

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="{StaticResource MediumSpacing}">

                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="{StaticResource SmallSpacing}">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            FontSize="{StaticResource BodyFontSize}"
                                            TextColor="{StaticResource Gray900}"
                                            VerticalOptions="Center" />

                                        <controls:StatusBadge
                                            Grid.Column="1"
                                            Status="{Binding Status}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding SiteName}"
                                        FontSize="{StaticResource CaptionFontSize}"
                                        TextColor="{StaticResource Gray500}" />

                                    <Grid
                                        Grid.Row="2"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="{StaticResource SmallSpacing}">

                                        <Border
                                            Grid.Column="0"
                                            Padding="{StaticResource SmallPadding}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">

                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityHighBackground}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Medium">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityMediumBackground}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="Low">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PriorityLowBackground}" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Label
                                                Text="{Binding Priority}"
                                                FontSize="{StaticResource SmallFontSize}"
                                                FontAttributes="Bold">

                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="High">
                                                        <Setter Property="TextColor" Value="{StaticResource PriorityHigh}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Medium">
                                                        <Setter Property="TextColor" Value="{StaticResource PriorityMedium}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Low">
                                                        <Setter Property="TextColor" Value="{StaticResource PriorityLow}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ScheduledOn, Converter={StaticResource DateToRelativeTextConverter}, StringFormat='Scheduled: {0}'}"
                                            FontSize="{StaticResource CaptionFontSize}"
                                            TextColor="{StaticResource Gray500}"
                                            HorizontalTextAlignment="End"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </RefreshView>

        <!-- Empty State -->
        <Grid
            Grid.Row="3"
            ZIndex="1"
            InputTransparent="True"
            IsVisible="{Binding HasInspections, Converter={StaticResource InverseBooleanConverter}}">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="{StaticResource SmallSpacing}">

                <Label
                    Text="No inspections found"
                    FontSize="{StaticResource BodyFontSize}"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Gray600}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Try changing your search."
                    FontSize="{StaticResource CaptionFontSize}"
                    TextColor="{StaticResource Gray500}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Grid.Triggers>
                <DataTrigger
                    TargetType="Grid"
                    Binding="{Binding IsBusy}"
                    Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Grid.Triggers>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            ZIndex="2" />

    </Grid>
</ContentPage>
